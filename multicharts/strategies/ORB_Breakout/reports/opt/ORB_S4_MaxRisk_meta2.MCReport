[MCReport\OptimizationReport\ChartContext\Strategy\StrategyHelper\OptimizerProperties\Algorithm_0]
	CFFScriptGenetic = '// TODO: Enter your formula to replace the samples below 

/************************************* Sample 1 ******************************************/
if (StrategyPerformance.MaxStrategyDrawDown != 0) {
   return StrategyPerformance.NetProfit / (-StrategyPerformance.MaxStrategyDrawDown);
}

/* This function maximizes the ratio of Net Profit to Max Drawdown.  The goal of this function is to find the trading rules that have a high net profit, but a small total drawdown over the back-tested period. */

/************************************* Sample 2 ******************************************/
// return StrategyPerformance.WinningTrades - StrategyPerformance.LosingTrades;

/* This function maximizes the number of Winning trades minus the number of Losing Trades. */


/************************************* Sample 3 ******************************************/
// if (StrategyPerformance.GrossLoss != 0) {
//    return StrategyPerformance.GrossProfit / StrategyPerformance.GrossLoss;
// }
/* This function maximizes the ratio of gross profit to gross loss. The smaller the gross loss is and the higher the gross profit is the higher this ratio will be. */

/************************************* Sample 4 ******************************************/
// if (StrategyPerformance.TotalTrades != 0) {
//    return StrategyPerformance.WinningTrades / StrategyPerformance.TotalTrades;
// }
/* This function maximizes the percent of profitable trades. */


/*

The reserved words supported in Multicharts optimization:
* NetProfit
* GrossProfit
* GrossLoss
* TotalTrades
* PercentProfitable
* WinningTrades
* LosingTrades
* AvgTrade
