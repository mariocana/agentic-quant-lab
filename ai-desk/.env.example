# Copy to .env. Never commit .env.
HL_TESTNET=1
# Master account address (the one that holds funds). Read-only use: user_state, fills.
HL_ACCOUNT_ADDRESS=0x...
# API wallet private key (agent wallet). Created at app.hyperliquid.xyz/API.
# It can sign orders but cannot withdraw. Never put the master key here.
HL_API_WALLET_KEY=0x...
# Unified account: the exchange lets spot USDC back perp margin and the app shows
# the sum as "Available to Trade". The API reports the two balances separately and
# never says which mode the account is in, so declare it here rather than have the
# desk guess how much capital it has.
HL_UNIFIED_COLLATERAL=0

# Optional: Telegram alerts. Leave empty to print to stdout.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
