<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mario.ai-desk.daily</string>
  <key>ProgramArguments</key>
  <array><string>/Users/mario/Documents/Repo/my-codes/python/ai-desk/launchd/run_cycle.sh</string></array>
  <key>StandardOutPath</key><string>/Users/mario/Documents/Repo/my-codes/python/ai-desk/var/cron.log</string>
  <key>StandardErrorPath</key><string>/Users/mario/Documents/Repo/my-codes/python/ai-desk/var/cron.log</string>
  <key>WorkingDirectory</key><string>/Users/mario/Documents/Repo/my-codes/python/ai-desk</string>
  <!-- 02:05 local = 00:05 UTC in winter, 01:05 UTC in summer. The strategy reads
       closed daily bars, so the exact minute does not change the signal. If the Mac
       is off or asleep at that time, launchd runs the job as soon as it wakes. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>5</integer></dict>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
